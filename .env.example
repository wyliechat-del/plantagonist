# Copy this file to .env (which Git ignores) and fill in real values.
# Never commit a real key, and never paste one into a chat.

# Roblox Open Cloud API key (Creator Hub > All tools > API keys).
# Give it only the permissions a task needs.
ROBLOX_OPEN_CLOUD_API_KEY=

# The published experience and place IDs (from Creator Hub).
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# Cloudflare Workers AI, for generating art with scripts/images/generate.py.
# Account ID: Cloudflare dashboard > Account home > the ... next to your
# account > Copy account ID. Token: My Profile > API Tokens > Create Token >
# "Workers AI" template. See docs/images.md.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
