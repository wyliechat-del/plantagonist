local Config = require("../src/shared/Config/PowerUps")
local PowerUps = require("../src/shared/Rules/PowerUps")

return function(t)
	t.test("venom stops power ups for 0.5 s per attacker level", function()
		local effect = PowerUps.attackEffect(Config, "spider", 4)
		t.expectEqual(effect.lockoutSeconds, 2)
		t.expectEqual(effect.damageMultiplier, 1)
		t.expectEqual(PowerUps.attackEffect(Config, "wasp", 2).lockoutSeconds, 1)
	end)

	t.test("bee venom lasts twice as long and sticks", function()
		local effect = PowerUps.attackEffect(Config, "bee", 4)
		t.expectEqual(effect.lockoutSeconds, 4)
		t.expect(effect.sticky)
	end)

	t.test("bite and slash doubles damage", function()
		t.expectEqual(PowerUps.attackEffect(Config, "bullAnt", 3).damageMultiplier, 2)
		t.expectEqual(PowerUps.attackEffect(Config, "snake", 3).damageMultiplier, 2)
	end)

	t.test("strangle holds for 0.5 s per attacker level", function()
		t.expectEqual(PowerUps.attackEffect(Config, "eel", 6).holdSeconds, 3)
		t.expectEqual(PowerUps.attackEffect(Config, "chameleon", 2).holdSeconds, 1)
	end)

	t.test("bombardier beetle removes the oldest power up", function()
		local effect = PowerUps.attackEffect(Config, "bombardierBeetle", 3)
		t.expect(effect.removeOldestPowerUp)
		t.expectEqual(effect.holdSeconds, 0)
	end)

	t.test("special moves scale with level", function()
		t.expectEqual(PowerUps.selfEffect(Config, "bat", 3).flySeconds, 3)
		t.expectEqual(PowerUps.selfEffect(Config, "stickInsect", 2).invisibleSeconds, 2)
		local burst = PowerUps.selfEffect(Config, "centipede", 4)
		t.expectEqual(burst.speedBurst, 6)
		t.expectEqual(burst.speedBurstSeconds, 2)
		t.expect(PowerUps.selfEffect(Config, "blowfish", 1).ballSeconds > 0)
	end)

	t.test("defences block only their own family's power up attacks", function()
		t.expect(PowerUps.defenceBlocks(Config, "toad", "spider"))
		t.expect(PowerUps.defenceBlocks(Config, "snail", "snake"))
		t.expect(PowerUps.defenceBlocks(Config, "skunk", "bombardierBeetle"))
		t.expect(not PowerUps.defenceBlocks(Config, "toad", "eel"), "wrong family")
		t.expect(not PowerUps.defenceBlocks(Config, "snail", "mantis"), "specials are not attacks")
	end)

	t.test("mantis keeps the next bite and slash power up", function()
		local effect = PowerUps.selfEffect(Config, "mantis", 1)
		t.expectEqual(effect.keepNextFamilyPowerUp, "BiteAndSlash")
		t.expectEqual(effect.reuseSeconds, 0.8)
		local usedUp, spent = PowerUps.isUsedUp(Config, "bullAnt", effect.keepNextFamilyPowerUp)
		t.expect(not usedUp)
		t.expect(spent)
		usedUp, spent = PowerUps.isUsedUp(Config, "spider", effect.keepNextFamilyPowerUp)
		t.expect(usedUp, "other families are used up as normal")
		t.expect(not spent)
	end)

	t.test("slot types", function()
		t.expectEqual(PowerUps.slotTypeFor(Config, "toad"), "defence")
		t.expectEqual(PowerUps.slotTypeFor(Config, "bat"), "attack")
		t.expectEqual(PowerUps.slotTypeFor(Config, "wasp"), "attack")
	end)
end
