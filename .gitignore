# Built place files (made by `rojo build`)
/build/
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# Secrets: API keys live here or in your shell, never in Git
.env
.env.*
!.env.example

# Editor and OS clutter
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
sourcemap.json

# Blender: backups and exports (exports are rebuilt from the .blend)
*.blend1
*.blend2
/models/export/

# Generated art drafts (move keepers into art/ to commit them)
/art/generated/

# Python bytecode
__pycache__/
